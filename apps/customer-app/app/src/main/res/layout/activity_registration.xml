<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/your_details"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/details_sub"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:paddingBottom="16dp" />

        <EditText
            android:id="@+id/inName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/full_name"
            android:inputType="textPersonName"
            android:autofillHints="name"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/inPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/phone"
            android:inputType="phone"
            android:autofillHints="phone"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/inNid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/nid"
            android:inputType="text"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/inDealer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dealer_no"
            android:inputType="text"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/inAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/address"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/signature"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <com.financesuperkey.dpc.SignatureView
            android:id="@+id/signature"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/card_bg" />

        <Button
            android:id="@+id/btnClearSig"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/clear"
            android:minHeight="0dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <CheckBox
            android:id="@+id/cbConsent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/consent_checkbox"
            android:textSize="12.5sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/submit"
            android:backgroundTint="@color/navy"
            android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>
