<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FinanceKey" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/navy</item>
    </style>

    <!-- Full-screen dark theme for the restricted hold screen. -->
    <style name="Theme.FinanceKey.Restricted" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/crit_dark</item>
        <item name="android:statusBarColor">@color/crit_dark</item>
    </style>
</resources>
