# কখনো আসল key commit করবেন না — এটা শুধু টেমপ্লেট
# Copy to .env and fill in. In production, use a cloud secret manager.

DATABASE_URL=postgresql://financekey:financekey@localhost:5432/financekey?schema=public

# JWT — generate strong random values (e.g. `openssl rand -base64 48`)
JWT_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Server
PORT=3000

# Device enrollment (QR provisioning payload)
PUBLIC_API_BASE=http://localhost:3000/v1
DPC_APK_URL=https://admin.deencircle.online/financekey/apk/finance-key.apk

# Optional
REDIS_URL=redis://localhost:6379
S3_BUCKET=
S3_REGION=
FCM_SERVER_KEY=
